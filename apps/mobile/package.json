{
  "name": "@qr-app/mobile",
  "version": "1.0.0",
  "description": "QR Creation Application - Android App",
  "private": true,
  "scripts": {
    "build:web": "cd ../web && pnpm build && cd ../mobile",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:run": "npx cap run android",
    "build:android:debug": "cd android && ./gradlew assembleDebug && cd ..",
    "build:android:release": "cd android && ./gradlew bundleRelease && cd ..",
    "build:apk": "cd android && ./gradlew assembleRelease && cd ..",
    "icons": "node scripts/generate-icons.js",
    "splash": "node scripts/generate-splash.js",
    "prepare": "npm run icons && npm run splash && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/browser": "^6.0.0",
    "@capacitor/camera": "^6.0.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/keyboard": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "sharp": "^0.33.0"
  }
}
