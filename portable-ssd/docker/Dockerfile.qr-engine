# CloudConnect QR Engine — Python Flask
FROM python:3.12-slim

WORKDIR /app

# Install system dependencies for QR code generation
RUN apt-get update && apt-get install -y --no-install-recommends \
    libzbar0 \
    libpng-dev \
    libjpeg-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements-qr.txt ./
RUN pip install --no-cache-dir -r requirements-qr.txt

# Copy QR engine source
COPY QR-engine.py ./

# Non-root user
RUN useradd -m -s /bin/bash qruser
USER qruser

EXPOSE 5001

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:5001/health || exit 1

CMD ["python", "QR-engine.py"]
