# ============================================================================
# CloudConnect Portable SSD — Environment Configuration
# ============================================================================

# Persistence root (auto-detected, rarely needs changing)
PERSIST_ROOT=/mnt/persist

# ── QR Creation App ───────────────────────────────────────────────────────
POSTGRES_DB=qr_app
POSTGRES_USER=cloudconnect
POSTGRES_PASSWORD=cloudconnect_local_dev
QR_ENGINE_API_KEY=portable-ssd-dev-key
QR_ENGINE_HMAC_SECRET=portable-ssd-hmac-secret
NEXTAUTH_SECRET=portable-ssd-nextauth-secret
NEXTAUTH_URL=http://localhost:3000

# ── AI Stack ──────────────────────────────────────────────────────────────
# Ollama is configured to auto-detect GPU
# Default model pulled on first boot: llama3.2:3b

# ── Custom Settings ───────────────────────────────────────────────────────
# Override any service-specific env vars below
